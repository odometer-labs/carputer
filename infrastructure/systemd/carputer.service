[Unit]
Description=GPS Carputer Application
After=network.target chrony.service gpsd.service docker.service
Wants=chrony.service gpsd.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=emb_usr
Group=emb_usr
WorkingDirectory=/opt/carputer
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=carputer
# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/carputer /var/lib/carputer /var/log/carputer
# Watchdog
WatchdogSec=60
NotifyAccess=all

[Install]
WantedBy=multi-user.target
